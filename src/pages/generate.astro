---
import Layout from "@/layouts/Layout.astro";
import GenerationSpike from "@/components/generation/GenerationSpike";
import { AI_MODELS, DEFAULT_AI_MODEL_ID } from "@/lib/ai/models";
---

<Layout title="Generowanie fiszek (test)">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto my-8 w-full max-w-5xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Generowanie fiszek (test)
        </h1>
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">
          ← Dashboard
        </a>
      </div>
      <GenerationSpike models={AI_MODELS} defaultModelId={DEFAULT_AI_MODEL_ID} client:load />
    </div>
  </div>
</Layout>
