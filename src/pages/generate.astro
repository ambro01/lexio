---
import Layout from "@/layouts/Layout.astro";
import LessonGenerator from "@/components/lesson/LessonGenerator";
import { MAX_INPUT_WORDS } from "@/lib/ai/proposals";
import { suggestTags } from "@/lib/services/flashcards.service";
import { getProfile } from "@/lib/services/profiles.service";
import { createClient } from "@/lib/supabase";
import type { CefrLevel } from "@/types";

// The middleware redirects anonymous users, so the user is always set here.
const userId = Astro.locals.user?.id ?? "";

// Both are conveniences: without tag suggestions the user simply types a new tag, and without a level
// the review shows no "too easy" group (only a hint to set the level).
let tagNames: string[] = [];
let level: CefrLevel | null = null;
const client = createClient(Astro.request.headers, Astro.cookies);
if (client) {
  [tagNames, level] = await Promise.all([
    suggestTags(client).then(
      (tags) => tags.map((tag) => tag.name),
      () => [],
    ),
    getProfile(client).then(
      (profile) => profile.cefrLevel,
      () => null,
    ),
  ]);
}
---

<Layout title="Nowa lekcja">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto my-8 w-full max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl sm:p-8">
      <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Nowa lekcja
        </h1>
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">
          ← Dashboard
        </a>
      </div>
      <LessonGenerator userId={userId} tagNames={tagNames} maxWords={MAX_INPUT_WORDS} level={level} client:load />
    </div>
  </div>
</Layout>
