---
import Layout from "@/layouts/Layout.astro";
import UpdatePasswordForm from "@/components/auth/UpdatePasswordForm";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
---

<Layout title={user ? "Set new password" : "Link expired"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      {user ? (
        <>
          <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
            Set new password
          </h1>
          <UpdatePasswordForm serverError={error} client:load />
        </>
      ) : (
        <div class="text-center">
          <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            Link expired
          </h1>
          <p class="mb-6 text-blue-100/80">This reset link is invalid or has expired.</p>
          <a href="/auth/forgot-password" class="text-sm text-purple-300 hover:underline">
            Request a new link
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
